FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY core-service-api/package.json core-service-api/package.json
COPY web-app/package.json web-app/package.json
COPY packages/instrument/package.json packages/instrument/package.json
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY packages/instrument packages/instrument
COPY core-service-api core-service-api
RUN npm run build -w @vr/instrument
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build DIRECT_URL=postgresql://build:build@localhost:5432/build npm run db:generate
RUN npm run build -w core-service-api
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "-w", "core-service-api"]
