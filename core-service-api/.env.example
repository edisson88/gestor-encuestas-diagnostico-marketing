# PostgreSQL connection strings from Neon. This is NOT a Neon REST API key.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
PORT=3000
FRONTEND_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_TTL_SECONDS=14400
NODE_ENV=development
# Complete before db:seed; no default account or password is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Text shown to participants. Complete BEFORE real data collection.
STUDY_INSTITUTION=
STUDY_RESPONSIBLE=
STUDY_CONTACT=
STUDY_DATA_ACCESS=
STUDY_CUSTODY=
STUDY_RETENTION=
